logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Переменные окружения
.env
.env.local
.env.*.local

# Сборка
dist/
build/
.next/
out/

# Кэш
.cache/
.parcel-cache/
.turbo/

# Покрытие тестов
coverage/

# Разное
.DS_Store
Thumbs.db
*.swp
*.swo

# -----------------------------------------------------------------------------
